{
  "expo": {
    "name": "NextRep",
    "slug": "nextrep",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "nextrep",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0B0D",
    "jsEngine": "hermes",
    "ios": {
      "icon": "./assets/images/logo.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.nextrep.fitnesstracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0D",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "package": "com.nextrep.fitnesstracker",
      "predictiveBackGestureEnabled": true,
      "allowBackup": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0B0D",
          "image": "./assets/images/adaptive-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0A0B0D"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-sharing",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF8C00"
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_workout": {
              "foregroundImage": "./assets/images/shortcut-workout.png",
              "backgroundColor": "#0A0B0D"
            },
            "shortcut_progress": {
              "foregroundImage": "./assets/images/shortcut-progress.png",
              "backgroundColor": "#0A0B0D"
            }
          },
          "iosActions": [
            {
              "id": "workout",
              "title": "Workout",
              "subtitle": "Start or view workouts",
              "icon": "symbol:dumbbell.fill",
              "params": {
                "href": "/(tabs)/workouts"
              }
            },
            {
              "id": "progress",
              "title": "Progress",
              "subtitle": "View stats & analytics",
              "icon": "symbol:chart.line.uptrend.xyaxis",
              "params": {
                "href": "/(tabs)/progress"
              }
            }
          ]
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b77fdac6-7527-4d6d-8923-378534463db3"
      }
    }
  }
}