{
  "expo": {
    "name": "NextRep",
    "slug": "nextrep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "nextrep",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0B0D",
    "ios": {
      "icon": "./assets/images/logo.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.nextrep.fitness"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0D",
        "foregroundImage": "./assets/images/logo.png"
      },
      "package": "com.nextrep.fitness",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0B0D",
          "image": "./assets/images/logo-glow.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0A0B0D"
          }
        }
      ],
      "expo-build-properties",
      {
        "android": {
          "enableMinifyInReleaseBuilds": true
        }
      },
      "expo-sharing",
      "expo-video",
      "expo-notifications",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b77fdac6-7527-4d6d-8923-378534463db3"
      }
    }
  }
}
